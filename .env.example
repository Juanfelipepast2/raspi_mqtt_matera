# =============================================================================
# .env.example — Copiá este archivo a .env y completá tus credenciales.
#   cp .env.example .env && nano .env
# Los TOPICS deben coincidir EXACTAMENTE con los de src/core/config.h del ESP32.
# =============================================================================

# ----- HiveMQ Cloud (TLS) ----------------------------------------------------
MQTT_HOST=xxxxxxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=matera
MQTT_PASS=CAMBIA_ESTA_CLAVE
# Debe ser DISTINTO al client-id del ESP32 (matera-esp32). Si lo dejás vacío o
# como "matera-raspi", se le agrega un sufijo aleatorio único automáticamente.
MQTT_CLIENT_ID=matera-raspi
MQTT_KEEPALIVE=120

# ----- Topics (igual que el ESP) ---------------------------------------------
TOPIC_SENSORS=matera/sensors
TOPIC_STATE=matera/state
TOPIC_CMD_PUMP=matera/cmd/pump
TOPIC_CMD_PLAY=matera/cmd/play
TOPIC_CMD_STOP=matera/cmd/stop
TOPIC_CMD_VOLUME=matera/cmd/volume
TOPIC_CMD_THRESHOLD=matera/cmd/threshold
TOPIC_CMD_IRR_INTERVAL=matera/cmd/irr_interval
TOPIC_CMD_NEO_BRIGHT=matera/cmd/neo/bright
TOPIC_CMD_NEO_PATTERN=matera/cmd/neo/pattern
TOPIC_CMD_NEO_COLOR=matera/cmd/neo/color

# ----- Servidor web ----------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000

# ----- Acceso web (HTTP Basic Auth) ------------------------------------------
# Si MATERA_ID y WEB_PASS están definidos, los comandos requieren autenticación.
# La página de sensores es pública. Dejá vacíos para deshabilitar (desarrollo local).
MATERA_ID=mi-matera
WEB_PASS=CAMBIA_ESTA_CLAVE

# ----- Histórico (SQLite) ----------------------------------------------------
# Ruta del archivo de la base de datos del histórico de sensores.
DB_PATH=history.db
